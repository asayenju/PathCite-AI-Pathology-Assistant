# Copy to .env (gitignored) and fill in. Never commit real keys.
# TypeSafe Jev API key, used by the backend for doctor-sentence triage (docs/PRD-jev-triage.md).
JEV_KEY=

# OpenAI API key for embeddings (text-embedding-3-small). Used by backend scripts to embed the
# evidence corpus (docs/PRD-corpus-ingest.md); the claim checker will also embed claims with it.
OPEN_AI_VECTOR_KEY=
# OpenAI key for the claim checker (gpt-6-luna verdicts, docs/PRD-rag-checker.md). Backend only.
OPEN_AI_KEY=

# Supabase (pgvector evidence store for the claim checker). Dashboard: Project Settings > API Keys.
SUPABASE_URL=
# Publishable key: safe for browsers, only needed once there is auth.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: full project access. Backend only, never send to the frontend.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
